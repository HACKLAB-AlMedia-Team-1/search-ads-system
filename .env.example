# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Smart model for the investigator agent, fast/cheap model for judge + onboarding
CLAUDE_MODEL_AGENT=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# LLM_MODE controls API spending:
#   offline = no API calls; a rule-based fallback agent runs (use while coding + in tests)
#   live    = real Claude calls
#   record  = real Claude calls AND save every call to agent/recordings/ (use for final demo runs)
#   replay  = no API calls; replays a saved recording (use for the video / stage fallback)
LLM_MODE=offline

# Safety caps per investigation
MAX_TOOL_CALLS=12
MAX_OUTPUT_TOKENS_PER_CALL=1500

# --- Linkup (web search for the agent) ---
LINKUP_API_KEY=
# offline = never call Linkup (returns "web check skipped"); live = real calls (cached to disk)
LINKUP_MODE=offline

# --- Simulation ---
SIM_SEED=42
SIM_START=2026-11-07T00:00:00
DEMO_DAY_START=2026-11-21T00:00:00
# Real seconds per simulated hour in live mode (demo speed)
SECONDS_PER_SIM_HOUR=3

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DUCKDB_PATH=data/rootsight.duckdb
