# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# --- LLM (optional; the default offline mode needs no model and no key) ---
# LLM_MODE:
#   offline = no model calls; the rule-based agent runs (default; use while coding + in tests)
#   live    = calls an OpenAI-compatible endpoint (implemented in Phase 6)
#   record  = like live AND saves every call to agent/recordings/ (implemented in Phase 6)
#   replay  = no calls; replays a saved recording
LLM_MODE=offline
# Optional local model, e.g. Ollama: http://127.0.0.1:11434/v1 (no key needed on a local address).
# A cloud endpoint is optional and not needed; it would require LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
# Two roles: the investigator agent and a fast model for judge + onboarding
LLM_MODEL_AGENT=
LLM_MODEL_FAST=
# Optional JSON added to every model request, e.g. {"reasoning_effort": "none"} to switch off a local model's thinking
LLM_EXTRA_BODY=
# No model API key but a Devin account? Set LLM_BASE_URL=devin-cli and model names such as opus / sonnet, give the
# full path of the Devin CLI below and run `devin auth login` once. No key is sent anywhere on this route.
DEVIN_CLI=devin
# To compare the rule-based agent with local and cloud models: python scripts/compare_models.py --help
# (it uses LLM_BASE_URL + LLM_API_KEY above for the cloud models and leaves LLM_MODE alone)

# Safety caps per investigation
MAX_TOOL_CALLS=12
MAX_OUTPUT_TOKENS_PER_CALL=1500

# --- Linkup (web search for the agent) ---
LINKUP_API_KEY=
# offline = never call Linkup (returns "web check skipped"); live = real calls (cached to disk)
LINKUP_MODE=offline

# --- Simulation ---
SIM_SEED=42
SIM_START=2026-11-07T00:00:00
DEMO_DAY_START=2026-11-21T00:00:00
# Real seconds per simulated hour in live mode (demo speed)
SECONDS_PER_SIM_HOUR=3

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DUCKDB_PATH=data/rootsight.duckdb
